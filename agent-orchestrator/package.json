{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "description": "Cursor SDK ile kullanıcı isteklerini agent botlarına dağıtan orchestrator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "models": "tsx src/cli.ts models"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
