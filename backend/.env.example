# KentScan Backend — Ortam Değişkenleri
# cp .env.example .env ile kopyalayın, değerleri doldurun

# Sunucu
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterfabric
DB_USER=masterfabric
DB_PASSWORD=masterfabric
DB_SSL_MODE=disable

# Redis (RBAC cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY=24h

# AI Servis URL (Python FastAPI)
AI_SERVICE_URL=http://localhost:8001

# Kafka (opsiyonel — kapalıysa scan akışı doğrudan çalışır)
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=false
