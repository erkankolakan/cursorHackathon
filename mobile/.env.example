# Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyala ve değerleri doldur
# .env.local dosyası .gitignore'da zaten var

# API (genel)
EXPO_PUBLIC_API_URL=https://api.example.com

# Cursor SDK backend adresi
# Simulator/web: http://localhost:4000
# Fiziksel cihaz: http://<bilgisayar-LAN-IP>:4000  (örn. http://192.168.1.20:4000)
EXPO_PUBLIC_CURSOR_API_URL=http://localhost:4000

# Analytics (opsiyonel)
# EXPO_PUBLIC_ANALYTICS_KEY=your_key_here

# Feature Flags (opsiyonel)
# EXPO_PUBLIC_ENABLE_DARK_MODE=true
