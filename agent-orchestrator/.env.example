# Cursor SDK kimlik doğrulama
# Bu dosyayı .env olarak kopyala ve değerini doldur.
# Anahtarı buradan al: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Varsayılan model (opsiyonel). composer-2.5 hızlı + ucuz, çoğu iş için ideal.
CURSOR_MODEL=composer-2.5

# Agent'ların üzerinde çalışacağı hedef proje klasörü (local runtime).
# Boş bırakılırsa orchestrator'ın çalıştığı klasör kullanılır.
TARGET_CWD=
